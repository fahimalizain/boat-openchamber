{
  "name": "boat-openchamber",
  "version": "0.2.0",
  "description": "boat.dev sandboxes in OpenChamber: Work Status rows, a rail panel for live agent conversations, and @ mentions.",
  "license": "MIT",
  "author": "Fahim Ali Zain",
  "keywords": [
    "openchamber",
    "openchamber-extension",
    "boat",
    "boat.dev",
    "sandbox",
    "cloud-agents"
  ],
  "homepage": "https://github.com/fahimalizain/boat-openchamber#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fahimalizain/boat-openchamber.git"
  },
  "bugs": {
    "url": "https://github.com/fahimalizain/boat-openchamber/issues"
  },
  "type": "module",
  "scripts": {
    "build": "sh scripts/bun.sh x openchamber-guest-bundle --node service/main.ts service/main.js && sh scripts/bun.sh x openchamber-guest-bundle panel/main.ts panel/main.js",
    "check": "sh scripts/bun.sh x openchamber-guest-check",
    "typecheck": "tsc --noEmit",
    "test": "node --test service/project/matcher.test.ts service/mentions/rows.test.ts shared/transcript.test.ts service/create/progress.test.ts service/create/request.test.ts panel/create-state.test.ts"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "id": "boat",
    "name": "Boat",
    "icon": "icon.svg",
    "contributes": {
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": ["boat", "git"]
        },
        "schedule": [{
          "id": "refresh",
          "cron": "*/15 * * * *"
        }]
      },
      "statusSection": {
        "source": {
          "path": "/status",
          "interval": 5000
        },
        "title": "Boat"
      },
      "panel": {
        "entry": "panel/index.html"
      },
      "mentions": {
        "label": "Sandboxes"
      },
      "instructions": true
    }
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "24",
    "typescript": "5"
  }
}
